PORT=4000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=spine
DATABASE_SSL=false
DATABASE_LOGGING=false

PATIENT_WEB_ORIGIN=http://localhost:5173
DOCTOR_WEB_ORIGIN=http://localhost:5176

# Passcode for the doctor panel. Change before any real use.
DOCTOR_PANEL_PASSCODE=
SESSION_SECRET=

# On-device summary model — scripts/summary-server.py, no API key, nothing
# leaves the machine. Point this at nothing (or set AI_SUMMARY_ENABLED=false)
# to force the deterministic template summary.
SUMMARY_MODEL_URL=http://localhost:8080
SUMMARY_MODEL_TIMEOUT_MS=30000
AI_SUMMARY_ENABLED=true

# Set to false to remove the "contact the clinic today" screen shown when a
# patient reports bladder, bowel or saddle symptoms. See plan.md §2.
EMERGENCY_INTERRUPT_ENABLED=true
