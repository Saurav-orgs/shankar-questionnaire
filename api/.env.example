PORT=4000

DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_USER=
DATABASE_PASSWORD=
DATABASE_NAME=spine
DATABASE_SSL=false
DATABASE_LOGGING=false
# On start the API runs pending migrations and seeds the doctor + current
# questionnaire (idempotent). Set to false to manage the schema by hand with
# `npm run db:setup`.
DB_AUTO_SETUP=true

# Passcode for the doctor panel. Change before any real use.
DOCTOR_PANEL_PASSCODE=
SESSION_SECRET=

# Set to false to remove the "contact the clinic today" screen shown when a
# patient reports bladder, bowel or saddle symptoms. See plan.md §2.
EMERGENCY_INTERRUPT_ENABLED=true

# --- Cross-origin ---
# Comma-separated list of allowed origins. Leave EMPTY to allow every origin
# (the API logs a warning at boot). Set it before handling real patient data:
# CORS_ORIGINS=https://patient.example.com,https://doctor.example.com
CORS_ORIGINS=

# --- Doctor session cookie ---
# true over HTTPS. Must stay false on plain http://localhost, because a Secure
# cookie is dropped on an insecure connection.
COOKIE_SECURE=false
# 'lax' when the doctor app and API share an origin. Use 'none' when they are on
# different domains, or the browser accepts the cookie and then refuses to send
# it on XHR — login succeeds and every later request 401s. 'none' requires
# COOKIE_SECURE=true; the API refuses to boot otherwise.
COOKIE_SAMESITE=lax

# Set to true when running behind a proxy or load balancer, so the real client IP
# is read from X-Forwarded-For for audit logs and rate limiting.
TRUST_PROXY=false
